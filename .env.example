# tf-agent 环境变量示例：复制为 .env 后按需修改（.env 已在 .gitignore 中）
#
# 优先级：真实环境变量 > .env > 代码内默认值。生产环境由 compose / K8s 注入，
# 不要把带密钥的 .env 提交进仓库。

# ── 运行模式 ──
APP_VERSION=dev
# 1 = 跳过网关签名校验（仅本机调试，生产必须留空）
FM_AGENT_DEV_MODE=1
# 写操作默认目标环境：prod / test
FM_AGENT_DEFAULT_ENV=prod

# ── 大模型（vLLM，OpenAI 兼容）──
FM_LLM_BASE_URL=http://127.0.0.1:8000/v1
FM_LLM_API_KEY=改成你笔记本 .env 里的 FM_LLM_API_KEY
FM_LLM_MODEL=qwen2.5-7b-instruct
FM_LLM_CONNECT_TIMEOUT=5
FM_LLM_READ_TIMEOUT=180
# vLLM --max-model-len：输入 + 输出总预算，必须与部署一致（默认 8192）
FM_LLM_CONTEXT_TOKENS=8192
# 首包前失败重试次数；已经开始流式后不再重试（避免前端收到重复正文）
FM_LLM_RETRIES=1

# ── 编排与限流（8192 上下文是硬顶，别放大）──
FM_AGENT_MAX_CONCURRENCY=2
FM_AGENT_QUEUE_LIMIT=4
FM_AGENT_TIMEOUT_SECONDS=120
FM_AGENT_TOOL_TIMEOUT_SECONDS=20
FM_AGENT_MAX_TOOL_ROUNDS=4
FM_AGENT_MAX_TOKENS=800
FM_AGENT_MAX_INPUT_CHARS=6000
FM_AGENT_HISTORY_LIMIT=10
FM_AGENT_RPM=10
# 同一轮多个只读工具的并发上限（Loki/MySQL/ES 别被一个请求打满）
FM_AGENT_TOOL_PARALLELISM=3
# SSE 心跳间隔（秒）：长工具调用期间防止网关/浏览器空闲断连
FM_AGENT_SSE_HEARTBEAT=10

# ── 审计库（集中机 fm-mysql 的 fm_agent 库）──
# 业务连接只能用运行时机器账号 fm_agent_app（仅 DML），不要写 root；
# 留空则审计降级（服务照常对话，日志里有 WARN）。
FM_AGENT_MYSQL_DSN=mysql+pymysql://fm_agent_app:CHANGE_ME@10.28.13.112:3306/fm_agent?charset=utf8mb4
# 建表/改表：只在执行 `python -m app.migrate` 时读取，用 fm_agent_migrate
FM_AGENT_MIGRATE_DSN=mysql+pymysql://fm_agent_migrate:CHANGE_ME@10.28.13.112:3306/fm_agent?charset=utf8mb4

# ── 数据源（集中在 .112）──
LOKI_URL=http://10.28.13.112:3100
LOKI_TIMEOUT_SECONDS=10
LOKI_SERVICE_LABEL=service
NACOS_URL=http://10.28.13.112:8848
NACOS_NAMESPACE=fm-prod
# 配置中心：启动拉一次 tf-agent.yaml，之后按 refresh 轮询热更新；拉不到用代码默认值
NACOS_ENABLED=1
NACOS_CONFIG_DATA_ID=tf-agent.yaml
NACOS_CONFIG_GROUP=FM
NACOS_REFRESH_SECONDS=60
# 服务注册：网关注册表里能发现本实例；本机开发建议设 0，避免把开发机挂进生产命名空间
NACOS_REGISTER=1
NACOS_SERVICE_NAME=tf-agent
# 上报给 Nacos 的 IP：容器里必须写宿主机可达地址，留空则用主机名解析
NACOS_INSTANCE_IP=
FM_AGENT_PORT=8201
# Nacos 2.x 开启鉴权时填
NACOS_USERNAME=
NACOS_PASSWORD=
# Nacos 不可用时的静态兜底：JSON，键为服务名
FM_AGENT_SERVICES={}

# ── GitHub（复用 tf-console 的 token，只读即可满足查流水线）──
GITHUB_TOKEN=
GITHUB_API=https://api.github.com
GITHUB_ORG=take-fish
# 重启服务用的 workflow（在各仓库 workflows 下）
FM_AGENT_RESTART_WORKFLOW=restart.yml

# ── 只读视图白名单（query_view 只能查这里列出的视图）──
FM_AGENT_DB_DSN=
FM_AGENT_DB_VIEWS={}

# ── 知识库 / 向量（Qdrant 已下线，向量库统一用 Elasticsearch）──
FM_KB_BACKEND=es
FM_KB_HYBRID=true
FM_KB_ES_URL=http://127.0.0.1:9200
FM_KB_ES_INDEX=fm_kb
FM_KB_ES_USERNAME=
FM_KB_ES_PASSWORD=
FM_KB_ES_TIMEOUT=10
FM_EMBED_MODEL=BAAI/bge-base-zh-v1.5
FM_EMBED_MODEL_PATH=D:\fishmatrix-llm\models\bge-base-zh-v1.5
FM_EMBED_DIM=768
FM_KB_CHUNK_SIZE=500
FM_KB_CHUNK_OVERLAP=80
FM_KB_TOP_K=8
FM_KB_MAX_CHUNKS=5
FM_KB_CHUNK_CHARS=300
FM_AGENT_UPLOAD_DIR=data/uploads

# ── 网关签名（生产必填，与 tf-gateway 保持一致）──
FM_IDENTITY_SECRET=
FM_IDENTITY_TTL_SECONDS=120
# 写操作确认令牌的签名密钥；留空复用 FM_IDENTITY_SECRET
FM_CONFIRM_SECRET=
