# tf-agent 环境变量示例：复制为 .env 后按需修改（.env 已在 .gitignore 中）
#
# 优先级：真实环境变量 > .env > 代码内默认值。生产环境由 compose / K8s 注入，
# 不要把带密钥的 .env 提交进仓库。

# ── 运行模式 ──
APP_VERSION=dev
# 1 = 跳过网关签名校验（仅本机调试，生产必须留空）
FM_AGENT_DEV_MODE=1
# 写操作默认目标环境：prod / test
FM_AGENT_DEFAULT_ENV=prod

# ── 大模型（vLLM，OpenAI 兼容）──
FM_LLM_BASE_URL=http://127.0.0.1:8000/v1
FM_LLM_API_KEY=改成你笔记本 .env 里的 FM_LLM_API_KEY
FM_LLM_MODEL=qwen2.5-7b-instruct
FM_LLM_CONNECT_TIMEOUT=5
FM_LLM_READ_TIMEOUT=180

# ── 编排与限流（8192 上下文是硬顶，别放大）──
FM_AGENT_MAX_CONCURRENCY=2
FM_AGENT_QUEUE_LIMIT=4
FM_AGENT_TIMEOUT_SECONDS=120
FM_AGENT_TOOL_TIMEOUT_SECONDS=20
FM_AGENT_MAX_TOOL_ROUNDS=4
FM_AGENT_MAX_TOKENS=800
FM_AGENT_MAX_INPUT_CHARS=6000
FM_AGENT_HISTORY_LIMIT=10
FM_AGENT_RPM=10

# ── 审计库（MySQL，库名固定 fm_agent）──
FM_AGENT_MYSQL_DSN=mysql+pymysql://root:fm123456@127.0.0.1:3307/fm_agent?charset=utf8mb4

# ── 数据源（集中在 .112）──
LOKI_URL=http://10.28.13.112:3100
LOKI_TIMEOUT_SECONDS=10
LOKI_SERVICE_LABEL=service
NACOS_URL=http://10.28.13.112:8848
NACOS_NAMESPACE=fm-prod
# Nacos 不可用时的静态兜底：JSON，键为服务名
FM_AGENT_SERVICES={}

# ── GitHub（复用 tf-console 的 token，只读即可满足查流水线）──
GITHUB_TOKEN=
GITHUB_API=https://api.github.com
GITHUB_ORG=take-fish
# 重启服务用的 workflow（在各仓库 workflows 下）
FM_AGENT_RESTART_WORKFLOW=restart.yml

# ── 只读视图白名单（query_view 只能查这里列出的视图）──
FM_AGENT_DB_DSN=
FM_AGENT_DB_VIEWS={}

# ── 知识库 / 向量 ──
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=fm_kb
FM_EMBED_MODEL=BAAI/bge-base-zh-v1.5
FM_EMBED_MODEL_PATH=D:\fishmatrix-llm\models\bge-base-zh-v1.5
FM_EMBED_DIM=768
FM_KB_CHUNK_SIZE=500
FM_KB_CHUNK_OVERLAP=80
FM_KB_TOP_K=8
FM_KB_MAX_CHUNKS=5
FM_KB_CHUNK_CHARS=300
FM_AGENT_UPLOAD_DIR=data/uploads

# ── 网关签名（生产必填，与 tf-gateway 保持一致）──
FM_IDENTITY_SECRET=
FM_IDENTITY_TTL_SECONDS=120
